# Public website/issuer origin. Production requires HTTPS.
NODE_ENV=production
PUBLIC_ORIGIN=https://accounts.example.org
HOST=127.0.0.1
PORT=17436
CORS_ORIGINS=https://accounts.example.org
# Only exact IPs of controlled proxies may supply a sanitized X-Real-IP.
TRUSTED_PROXY_IPS=127.0.0.1

# Separate runtime DML role and migration owner. Replace before use.
DATABASE_URL=postgresql://tessera_application:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5432/tessera
MIGRATION_DATABASE_URL=postgresql://tessera_migrator:REPLACE_WITH_MIGRATION_PASSWORD@127.0.0.1:5432/tessera
BETTER_AUTH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET

# Resource secrets are never shipped to native/web clients.
# For rotation add an old key with validUntil <= five minutes from restart.
RESOURCE_KEYS='[{"id":"cadence-primary","secret":"REPLACE_WITH_UNIQUE_RANDOM_RESOURCE_SECRET","products":["techmino","techminoGalaxy"]}]'
ACCOUNT_ADMIN_IDS=

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="26F Studio <accounts@example.org>"

# Exact registered web callback paths, comma-separated; same approved origin.
TECHMINO_WEB_CALLBACKS=https://accounts.example.org/play/techmino/
GALAXY_WEB_CALLBACKS=https://accounts.example.org/play/techmino-galaxy/
