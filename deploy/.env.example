# Techmino online deployment configuration.
#
# THIS IS A TEMPLATE. Every REPLACE_WITH_* value is an unfilled placeholder:
# this file is not a working deployment, and none of the hosts, certificates,
# mail accounts, or administrator IDs below are real. Copy it to deploy/.env,
# replace every placeholder, and keep the result at mode 0600.
#
# deploy/bootstrap.sh reads this file, validates it, and writes the protected
# runtime files under deploy/runtime/ (0700). Nothing in this repository or in
# those files may be committed or pasted into logs.

# "production" requires real SMTP with verified TLS and trusted certificates.
# "development" is for the isolated local exercise only (Mailpit fixture).
APP_ENV=production

# Public HTTPS origins. Use the exact hostname the certificate is issued for; the
# port is 443 for a normal deployment and may differ only for the local exercise.
# Do not use "localhost" here: inside a container it resolves to that container
# itself, so Cadence could not reach the account origin through the proxy.
ACCOUNT_HOST=REPLACE_WITH_ACCOUNT_HOSTNAME
ACCOUNT_PORT=443
GAME_HOST=REPLACE_WITH_GAME_HOSTNAME
GAME_PORT=443

# Address the edge proxy binds. 0.0.0.0 inside the container; 127.0.0.1 is
# appropriate only when the proxy runs directly on a host.
PROXY_BIND=0.0.0.0

# "manual" preserves operator-owned certificates and disables automatic HTTPS.
# "automatic" uses public ACME certificates persisted in proxy-data; use
# compose.public.yml, public DNS, and externally reachable TCP ports 80/443.
TLS_MODE=manual

# Operator-provided TLS material (absolute host paths, PEM). Bootstrap copies
# these into deploy/runtime/tls, which is mounted read-only into the proxy and
# Cadence. The account certificate must be valid for ACCOUNT_HOST, the game
# certificate for GAME_HOST. These four fields are unused in automatic mode.
ACCOUNT_TLS_CERT=REPLACE_WITH_ABSOLUTE_PATH_TO_ACCOUNT_FULLCHAIN_PEM
ACCOUNT_TLS_KEY=REPLACE_WITH_ABSOLUTE_PATH_TO_ACCOUNT_PRIVATE_KEY_PEM
GAME_TLS_CERT=REPLACE_WITH_ABSOLUTE_PATH_TO_GAME_FULLCHAIN_PEM
GAME_TLS_KEY=REPLACE_WITH_ABSOLUTE_PATH_TO_GAME_PRIVATE_KEY_PEM

# Optional: the CA that signs the account certificate when it is not publicly
# trusted. When set, Cadence validates the account origin against this CA only.
# Leave empty in automatic mode, which uses the standard public trust roots.
TESSERA_UPSTREAM_CA=

# Repository checkouts used as Docker build contexts.
TESSERA_REPO_DIR=..
CADENCE_REPO_DIR=../../../OtherProjects/Cadence
TECHMINO_SOURCE_DIR=../../../OtherProjects/Techmino
WEBSITE_REPO_DIR=../../../community-projects/26f-studio/26f-studio

# Game builds served at /play/<product>/ on the account origin. Operators place
# the real Web/WASM release builds here; the directory is handed to the proxy
# read-only. Relative paths are resolved against the deploy directory.
GAME_ROOTS_DIR=./game-roots
BACKUP_DIR=./backups
RESTORED_DIR=./restored

# Compose image tag used for locally built service images.
IMAGE_TAG=local

# Mail. "smtp" uses the real service below and requires APP_ENV=production with
# verified TLS at the application level. "local-fixture" targets the optional
# Mailpit compose profile and requires APP_ENV=development; it is an isolated
# fixture, not mail delivery. With MAIL_MODE=local-fixture the SMTP_HOST,
# SMTP_PORT, SMTP_USER and SMTP_PASSWORD values below are unused and may stay as
# placeholders; SMTP_FROM is still required.
MAIL_MODE=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER_ADDRESS

# Operator-owned identity lists. Empty means "no administrators configured".
# These are deployment configuration, never writable through a profile.
ACCOUNT_ADMIN_IDS=
CADENCE_GAME_ADMINS=

# Optional Mailpit fixture ports (only used with MAIL_MODE=local-fixture).
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025
